+import * as v from 'valibot';
+import { apiErrorResponseSchema } from '@app/schemas';
+import type {
+  FailureStatus,
+  UiProblem,
+  UiProblemKind,
+  EdenError,
+} from '../types';
+
+const statusArray: FailureStatus[] = [
+  400, 401, 403, 404, 409, 410, 422, 429, 500, 502, 503, 504,
+];
+
+const statusCode = {
+  validation: 400 | 422,
+  authentication: 401,
+  forbidden: 403,
+  notFound: 404 | 410,
+  conflict: 409,
+  unavailable: 429 | 502 | 503 | 504,
+  unexpected: 500,
+};
+
+const normaliseStatus = (status: number): FailureStatus | number => {
+  const failure = status as FailureStatus;
+  if (statusArray.includes(failure)) return status;
+  return 500;
+};
+
+const kindFromStatus = (status: FailureStatus): UiProblemKind => {
+  switch (status) {
+    case statusCode.validation:
+      return 'validation';
+    case statusCode.notFound:
+      return 'not-found';
+    case statusCode.authentication:
+      return 'unauthenticated';
+    case statusCode.forbidden:
+      return 'forbidden';
+    case statusCode.conflict:
+      return 'conflict';
+    case statusCode.unavailable:
+      return 'unavailable';
+    default:
+      return 'unexpected';
+  }
+};
